{% extends 'base.html.twig' %}

{% block title %}Authors Details!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Détails de l’auteur</h1>

    <img src="{{ author.picture }}" alt="{{ author.username }}"><br>
    <strong>Nom :</strong> {{ author.username }} <br>
    <strong>Email :</strong> {{ author.email }} <br>
    <strong>Nombre de livres :</strong> {{ author.nb_books }} <br><br>
</div>
{% endblock %}
