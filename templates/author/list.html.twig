{% extends 'base.html.twig' %}

{% block title %}Authors!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    {% set total_books = 0 %}
     <table border="1">
    <thead>
        <tr>
            <th>id</th>
            <th>picture</th>
            <th>username</th>
            <th>email</th>
            <th>nb_books</th>
        </tr>
    </thead>
    <tbody>
        {% for author in authors %}
            <tr>
                <td>{{ author.id }}</td>
                <td><img src="{{ author.picture }}" alt="{{ author.username }}"></td>
                <td>{{ author.username|upper }}</td>
                <td>{{ author.email }}</td>
                <td>{{ author.nb_books }}</td>
                <td><a href="{{ path('author_details', { id: author.id }) }}">Details</a></td>
                {% set total_books = total_books + author.nb_books %}

            </tr>
        {% else %}
                <tr>
                    <td colspan="5">No authors found</td>
                </tr>
        {% endfor %}
    </tbody>
</table>
<p>Nombre des auteurs : {{ authors|length }}</p>
<p>Nombre total des livres : {{ total_books }}</p>

</div>
{% endblock %}
